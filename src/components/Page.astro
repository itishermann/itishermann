---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { cv, t, ui, timeline, range, photoExists, resumeHref, type Lang } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const L = ui[lang];
const O = ui[other];
const b = cv.basics;
const tl = timeline();
const profile = (n: string) => (b.profiles || []).find((p: any) => p.network === n);
const github = profile('GitHub');
const linkedin = profile('LinkedIn');
const blog = profile('Blog');
const [firstName, ...rest] = b.name.split(' ');
const home = lang === 'fr' ? '/' : '/en/';
const ids = lang === 'fr'
  ? { work: 'parcours', skills: 'competences', projects: 'projets', education: 'formation', interests: 'centres-interet', contact: 'contact' }
  : { work: 'work', skills: 'skills', projects: 'projects', education: 'education', interests: 'interests', contact: 'contact' };
const edTitle = lang === 'fr' ? 'Formation et langues' : 'Education and languages';
---
<Base lang={lang}>
  <a class="skip" href={`#${ids.work}`}>{L.scroll}</a>
  <div class="lines" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>

  <header class="top">
    <a class="top__logo" href={home} aria-label="Hermann Kao">hermann<span>.</span></a>
    <button class="top__toggle" type="button" aria-expanded="false" aria-controls="sections" aria-label={L.menu} data-nav-toggle>
      <span class="top__burger" aria-hidden="true"></span>
    </button>
    <nav class="top__nav" id="sections" aria-label="Sections">
      <a href={home} data-spy="top">{L.nav.home}</a>
      <a href={`#${ids.work}`} data-spy={ids.work}>{L.nav.work}</a>
      <a href={`#${ids.skills}`} data-spy={ids.skills}>{L.nav.skills}</a>
      <a href={`#${ids.projects}`} data-spy={ids.projects}>{L.nav.projects}</a>
      {blog && <a href={blog.url} rel="me">{L.nav.blog}</a>}
      <a href={`#${ids.contact}`} data-spy={ids.contact}>{L.nav.contact}</a>
    </nav>
    <div class="top__lang">
      <a href="/" hreflang="fr" lang="fr" aria-current={lang === 'fr' ? 'page' : undefined} aria-label="Français">FR</a>
      <a href="/en/" hreflang="en" lang="en" aria-current={lang === 'en' ? 'page' : undefined} aria-label="English">EN</a>
    </div>
  </header>

  <main>
    <section class="hero" aria-labelledby="hello" data-section="top">
      <div class="hero__text">
        <p class="eyebrow"><span>{L.hello}</span><span class="eyebrow__other" lang={other}>{O.hello}</span></p>
        <h1 id="hello" class="hero__title">{L.iam} <span class="accent">{firstName}</span> {rest.join(' ')}</h1>
        <p class="hero__label">{t(b.label, lang)}</p>
        <p class="hero__summary">{t(b.summary, lang)}</p>
        <p class="hero__meta">{b.location.city}, France. {t(b.remote, lang)}.</p>
        <div class="cta">
          <a class="btn" href={resumeHref(lang)} download>{L.resume}</a>
          <a class="textlink" href={`#${ids.contact}`}>{L.contactCta}</a>
        </div>
      </div>

      <div class="hero__visual">
        <svg class="brush" viewBox="0 0 700 700" aria-hidden="true" focusable="false">
          <defs>
            <!-- Bords secs du pinceau : bruit étiré dans le sens du geste. -->
            <filter id="dry" x="-15%" y="-40%" width="130%" height="180%">
              <feTurbulence type="fractalNoise" baseFrequency="0.012 0.42" numOctaves="3" seed="11" result="n" />
              <feDisplacementMap in="SourceGraphic" in2="n" scale="46" xChannelSelector="R" yChannelSelector="G" />
            </filter>
          </defs>
          <g transform="rotate(-38 350 350)" filter="url(#dry)">
            <path d="M40 300 Q 180 262 360 270 T 660 286 L 664 410 Q 520 398 360 404 T 52 440 Z" />
            <path d="M120 450 Q 280 432 430 440 T 620 452 L 606 492 Q 430 486 300 492 T 128 500 Z" opacity="0.65" />
          </g>
        </svg>
        <div class="hero__photo">
          {photoExists
            ? <picture>
                <source srcset={b.photo.replace(/\.(jpe?g|png)$/, '.webp')} type="image/webp" />
                <img src={b.photo} alt={L.photoAlt} width="900" height="1200" fetchpriority="high" decoding="async" />
              </picture>
            : <div class="hero__monogram" role="img" aria-label={L.photoAlt}><span>HK</span></div>}
        </div>
      </div>

      <ul class="social" aria-label={L.social}>
        {github && <li><a href={github.url} rel="me" aria-label="GitHub"><Icon name="github" /></a></li>}
        {linkedin && <li><a href={linkedin.url} rel="me" aria-label="LinkedIn"><Icon name="linkedin" /></a></li>}
        {blog && <li><a href={blog.url} rel="me" aria-label={L.nav.blog}><Icon name="hashnode" /></a></li>}
      </ul>

      <a class="scrolldown" href={`#${ids.work}`}>{L.scrollDown}</a>
    </section>

    <section id={ids.work} class="section work" aria-labelledby="work-title" data-section={ids.work}>
      <div class="section__head">
        <p class="eyebrow">{L.eyebrow.work}</p>
        <h2 id="work-title">{L.workTitle}</h2>
        <p class="section__lead">{L.workIntro}</p>
      </div>

      <div class="work__grid" style={`--lanes:${tl.lanes}`}>
        <!-- Ruban temporel : axe des années + barres de durée. Deux barres côte à côte = missions simultanées. -->
        <div class="ribbon">
          <div class="ribbon__chart" aria-hidden="true">
            {tl.years.map((y) => <span class="ribbon__year" style={`--t:${y.topPct}`}>{y.year}</span>)}
            {tl.bars.map((bar) => (
              <span
                class:list={['ribbon__bar', { ongoing: bar.ongoing }]}
                data-bar={bar.id}
                style={`--lane:${bar.lane};--top:${bar.topPct};--h:${bar.heightPct}`}
              />
            ))}
          </div>
          <p class="ribbon__key">{L.graphKey}</p>
        </div>

        <ol class="roles">
          {tl.rows.map((row, i) => {
            const w = row.item;
            return (
              <li class:list={['role', { 'is-active': i === 0 }]} style={`--lane:${row.lane}`} data-role={w.id}>
                <p class="role__date"><span class="role__dot" aria-hidden="true"></span><time datetime={w.start}>{range(w.start, w.end, lang)}</time></p>
                <h3>{t(w.position, lang)}</h3>
                <p class="role__org">
                  {t(w.organization, lang)}
                  {w.contract && <><br />{t(w.contract, lang)}{w.location && `, ${t(w.location, lang)}`}</>}
                </p>
                {w.summary && <p class="role__summary">{t(w.summary, lang)}</p>}
                {w.highlights?.length > 0 && (
                  <ul class="role__list">
                    {w.highlights.map((h: any) => <li>{h[lang]}</li>)}
                  </ul>
                )}
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    <section id={ids.skills} class="section" aria-labelledby="skills-title" data-section={ids.skills}>
      <div class="section__head">
        <p class="eyebrow">{L.eyebrow.skills}</p>
        <h2 id="skills-title">{L.skills}</h2>
      </div>
      <dl class="skills">
        {cv.skills.map((s: any) => (
          <div class="skills__row">
            <dt>{t(s.name, lang)}</dt>
            <dd>{s.keywords.map((k: string) => <span>{k}</span>)}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section id={ids.projects} class="section" aria-labelledby="projects-title" data-section={ids.projects}>
      <div class="section__head">
        <p class="eyebrow">{L.eyebrow.projects}</p>
        <h2 id="projects-title">{L.projects}</h2>
      </div>
      <ul class="projects">
        {cv.projects.map((p: any) => (
          <li class:list={[{ 'is-link': !!p.url }]}>
            <h3>{p.url ? <a href={p.url} rel="noopener">{t(p.name, lang)}</a> : t(p.name, lang)}</h3>
            <p>{t(p.description, lang)}</p>
            {p.keywords?.length > 0 && <p class="projects__stack">{p.keywords.join(', ')}</p>}
          </li>
        ))}
      </ul>
    </section>

    <section id={ids.education} class="section" aria-labelledby="edu-title" data-section={ids.education}>
      <div class="section__head">
        <p class="eyebrow">{L.eyebrow.education}</p>
        <h2 id="edu-title">{edTitle}</h2>
      </div>
      <div class="split">
        <ul class="plain">
          {cv.education.map((e: any) => (
            <li><strong>{t(e.studyType, lang)}, {t(e.area, lang)}</strong><br />{e.institution}, {e.location}, {e.end}</li>
          ))}
        </ul>
        <ul class="plain">
          {cv.languages.map((l: any) => <li><strong>{t(l.language, lang)}</strong>, {t(l.fluency, lang)}</li>)}
        </ul>
      </div>
    </section>

    {cv.interests?.length > 0 && (
      <section id={ids.interests} class="section" aria-labelledby="interests-title" data-section={ids.interests}>
        <div class="section__head">
          <p class="eyebrow">{L.eyebrow.interests}</p>
          <h2 id="interests-title">{L.interestsTitle}</h2>
        </div>
        <p class="interests">{cv.interests.map((i: any) => t(i, lang)).join(' · ')}</p>
      </section>
    )}
  </main>

  <footer id={ids.contact} class="section contact" aria-labelledby="contact-title" data-section={ids.contact}>
    <div class="section__head">
      <p class="eyebrow">{L.eyebrow.contact}</p>
      <h2 id="contact-title">{L.contactTitle}</h2>
      <p class="section__lead">{L.contactLead}</p>
    </div>
    <form
      class="contact__form"
      id="contact-form"
      data-endpoint="https://forms.itishermann.me/forms/contact/submit?token=c347013cf1a9aa9e11410708578be279900b5c0a4c8cb9a9"
      data-sending={L.form.sending}
      data-ok={L.form.ok}
      data-error={L.form.error}
    >
      <div class="field field--half">
        <label for="cf-name">{L.form.name}</label>
        <input id="cf-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field field--half">
        <label for="cf-email">{L.form.email}</label>
        <input id="cf-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="cf-message">{L.form.message}</label>
        <textarea id="cf-message" name="message" rows="5" required></textarea>
      </div>
      <p class="contact__hp" aria-hidden="true">
        <label>{L.form.hp}<input type="text" name="__mf_hp" tabindex="-1" autocomplete="off" /></label>
      </p>
      <div class="cf-turnstile" data-sitekey="0x4AAAAAAFXaRyNnAwPTt0PQ" data-action="submit" data-theme="auto" data-size="flexible"></div>
      <div class="contact__submit">
        <button class="btn" type="submit">{L.form.send}</button>
        <p class="contact__status" data-status role="status" aria-live="polite"></p>
      </div>
    </form>
    <div class="cta">
      <a class="btn" href={resumeHref(lang)} download>{L.resume}</a>
      <a class="textlink" href={resumeHref(other)} download hreflang={other}>{L.cvOther}</a>
    </div>
  </footer>

  <nav class="dock" aria-label={L.quickActions} data-dock>
    <a class="dock__cv" href={resumeHref(lang)} download>{L.resumeShort}</a>
    <a class="dock__contact" href={`#${ids.contact}`}>{L.nav.contact}</a>
  </nav>

  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>

  <script>
    // Ruban au scroll : le poste lu au centre de l'écran s'active, et sa barre s'allume dans le ruban.
    const roles = [...document.querySelectorAll<HTMLElement>('.role')];
    const bars = new Map(
      [...document.querySelectorAll<HTMLElement>('.ribbon__bar')].map((b) => [b.dataset.bar ?? '', b]),
    );
    const roleIo = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const el = e.target as HTMLElement;
        roles.forEach((r) => r.classList.toggle('is-active', r === el));
        bars.forEach((b) => b.classList.remove('is-current'));
        bars.get(el.dataset.role ?? '')?.classList.add('is-current');
      }
    }, { rootMargin: '-45% 0px -50% 0px' });
    roles.forEach((r) => roleIo.observe(r));

    // Navigation : la section lue au milieu de l'écran est mise en avant dans le menu.
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
    const navIo = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const id = (e.target as HTMLElement).dataset.section;
        links.forEach((a) => (a.dataset.spy === id ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
      }
    }, { rootMargin: '-40% 0px -55% 0px' });
    document.querySelectorAll('[data-section]').forEach((s) => navIo.observe(s));

    // Menu de sections sur mobile : ouverture, fermeture (Échap / clic dehors / lien), focus piégé.
    const top = document.querySelector<HTMLElement>('.top');
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const panel = document.getElementById('sections');
    if (top && toggle && panel) {
      const panelLinks = () => [...panel.querySelectorAll<HTMLAnchorElement>('a')];
      const setNav = (open: boolean) => {
        top.classList.toggle('is-nav-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        if (open) panelLinks()[0]?.focus();
      };
      toggle.addEventListener('click', () => setNav(!top.classList.contains('is-nav-open')));
      panel.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setNav(false); });
      document.addEventListener('keydown', (e) => {
        if (!top.classList.contains('is-nav-open')) return;
        if (e.key === 'Escape') { setNav(false); toggle.focus(); return; }
        if (e.key === 'Tab') {
          // Tant que le menu est ouvert, Tab reste à l'intérieur (bouton + liens).
          const focusables = [toggle, ...panelLinks()];
          const first = focusables[0], last = focusables[focusables.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
      });
      document.addEventListener('click', (e) => { if (top.classList.contains('is-nav-open') && !top.contains(e.target as Node)) setNav(false); });
    }

    // Accès rapide flottant : apparaît une fois le hero passé, se retire sur la section contact.
    const dock = document.querySelector<HTMLElement>('.dock');
    const heroEl = document.querySelector('.hero');
    const contactEl = document.querySelector('.contact');
    if (dock && heroEl) {
      let pastHero = false, atContact = false;
      const sync = () => dock.classList.toggle('is-shown', pastHero && !atContact);
      new IntersectionObserver((es) => { for (const e of es) pastHero = !e.isIntersecting; sync(); }, { rootMargin: '-15% 0px 0px 0px' }).observe(heroEl);
      if (contactEl) new IntersectionObserver((es) => { for (const e of es) atContact = e.isIntersecting; sync(); }).observe(contactEl);
    }

    // Formulaire de contact : envoi via fetch vers Miniform, états inline, Turnstile réinitialisé.
    const cform = document.getElementById('contact-form');
    if (cform instanceof HTMLFormElement) {
      const cstatus = cform.querySelector<HTMLElement>('[data-status]');
      const cbtn = cform.querySelector<HTMLButtonElement>('button[type="submit"]');
      const setStatus = (text: string, state: string) => { if (cstatus) { cstatus.textContent = text; cstatus.dataset.state = state; } };
      cform.addEventListener('submit', async (e) => {
        e.preventDefault();
        setStatus(cform.dataset.sending ?? '', 'sending');
        if (cbtn) cbtn.disabled = true;
        try {
          const res = await fetch(cform.dataset.endpoint ?? '', { method: 'POST', body: new FormData(cform), headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error(String(res.status));
          cform.reset();
          setStatus(cform.dataset.ok ?? '', 'ok');
          (window as unknown as { turnstile?: { reset?: () => void } }).turnstile?.reset?.();
        } catch {
          setStatus(cform.dataset.error ?? '', 'error');
        } finally {
          if (cbtn) cbtn.disabled = false;
        }
      });
    }
  </script>
</Base>
